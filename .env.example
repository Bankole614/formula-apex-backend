# ==========================================
# Apex Racing GP Backend Environment Config
# ==========================================

APP_NAME="Apex Racing GP Backend"
PORT=8000
DEBUG=True

# Database Configuration (Defaults to local SQLite WAL file)
DATABASE_PATH=data/apex_racing.db

# ==========================================
# Cloudflare R2 Audio & Asset Storage
# ==========================================
# Get these from your Cloudflare Dashboard:
# -> R2 -> Overview -> Manage R2 API Tokens -> Create API Token
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=apex-racing-assets

# The public custom domain or r2.dev URL connected to your bucket
# Example: https://cdn.yourcustomdomain.com or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://cdn.apex-racing.dev

